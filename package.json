{
  "name": "langgraph-agentic-rag",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "db:bootstrap": "bash scripts/db-bootstrap.sh",
    "backend:start": "bash scripts/run-backend.sh",
    "backend:lint": "cd backend && uv run ruff check --fix .",
    "backend:format": "cd backend && uv run ruff format .",
    "backend:test": "cd backend && uv run pytest --ignore=tests/integration",
    "frontend:dev": "bun run --filter frontend dev",
    "frontend:lint": "bun run --filter frontend lint",
    "frontend:test": "bun run --filter frontend test"
  },
  "devDependencies": {
    "supabase": "2.114.0"
  }
}
